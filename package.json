{
  "name": "@petercjl/product-asset-set",
  "version": "0.1.2",
  "description": "Build reusable product reference image sets.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petercjl/product-asset-set.git"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "skills",
    "INSTALL.md",
    "UPDATE.md",
    "scripts/verify-package.mjs",
    "bin",
    "lib",
    "capabilities.json",
    "skill-integrity.json",
    "THIRD_PARTY_NOTICES.md",
    "scripts/sync-version.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "agentPackage": {
    "kind": "application-skill",
    "skills": [
      {
        "name": "product-asset-set",
        "path": "skills/product-asset-set"
      }
    ],
    "installation": "managed-physical-copy",
    "installGuide": "INSTALL.md",
    "updateGuide": "UPDATE.md"
  },
  "scripts": {
    "check": "node scripts/verify-package.mjs",
    "prepack": "node scripts/verify-package.mjs",
    "test": "node --test test/*.test.mjs",
    "version": "node scripts/sync-version.mjs --write",
    "postinstall": "node bin/product-asset-set.mjs install-notice"
  },
  "type": "module",
  "bin": {
    "product-asset-set": "bin/product-asset-set.mjs"
  }
}
