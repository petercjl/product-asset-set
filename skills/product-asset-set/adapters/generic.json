{
  "schema": "portable-skill-adapter",
  "platform": "generic",
  "mappings": [
    {
      "capability_id": "asset.guide",
      "status": "implemented",
      "features": [
        "verify-file-hashes",
        "verify-png-dimensions"
      ],
      "implementation": {
        "type": "node-script",
        "path": "scripts/asset-guide.mjs",
        "command": "check",
        "runtime": "Node.js 22+"
      }
    },
    {
      "capability_id": "media.image.edit",
      "status": "implemented",
      "features": [
        "ordered-references",
        "one-image",
        "local-artifact"
      ],
      "implementation": {
        "type": "host-discovery",
        "discovery": "Resolve the current host advertised image editing capability and verify required features before invocation.",
        "on_missing": "CAPABILITY_UNAVAILABLE",
        "on_unsupported": "FEATURE_UNSUPPORTED",
        "output": "Return a local image and actual invocation or task receipt when exposed."
      }
    }
  ]
}
